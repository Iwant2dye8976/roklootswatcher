# RoK Loot Watcher - Environment Configuration Example
# Copy this file to `.env` in the project root to set default compile-time credentials.

# -----------------------------------------------------------------------------
# Supabase Cloud Sync Configuration
# -----------------------------------------------------------------------------
# The URL of your Supabase project instance (e.g., https://xyzcompany.supabase.co)
ROK_SUPABASE_URL=https://your-project-id.supabase.co

# The public anonymous API key (anon key) for client-side API access
ROK_SUPABASE_ANON_KEY=your-supabase-anon-key-here
